# ============================================================
# upay Pulse — Environment Configuration Template
# ============================================================

PROJECT_NAME="upay Pulse"
PROJECT_TYPE="AI-powered MFS Intelligence Ecosystem"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security & Tokens
SECRET_KEY="upay_pulse_super_secure_demo_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (PostgreSQL default, falls back to SQLite if needed)
DATABASE_URL="postgresql+psycopg2://postgres:@localhost:5432/upay_pulse"
SQLITE_FALLBACK_URL="sqlite:///./upay_pulse.db"

# Redis & Event Bus (Hybrid in-memory fallback enabled)
REDIS_URL="redis://localhost:6379/0"
USE_REDIS_FALLBACK=True

# Risk Engine Thresholds (Configurable)
RISK_THRESHOLD_LOW=0.40
RISK_THRESHOLD_HIGH=0.75

# AI / Voice Coach Provider (gemini | openai | mock)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# CORS Allowed Origins
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Master Freeze Timeout (Target sub-300ms)
FREEZE_MAX_TIMEOUT_MS=300
